# ==============================================================================
# Apache Configuration for InfinityFree / cPanel
# Web Media Multistream - Production Config
# ==============================================================================

# 1. Seguridad básica y opciones de servidor
Options -Indexes -MultiViews
DirectoryIndex index.php

# 2. Codificación por defecto
AddDefaultCharset UTF-8

# 3. Tipos MIME para Streaming, Video y Subtítulos
<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/x-matroska .mkv
    AddType video/webm .webm
    AddType application/vnd.apple.mpegurl .m3u8
    AddType video/mp2t .ts
    AddType application/json .json
    AddType text/vtt .vtt
</IfModule>

# 4. Cabeceras CORS y Content-Disposition para streaming
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range"
    Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
</IfModule>

# 5. Compresión Gzip (mod_deflate) para máxima velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/vnd.apple.mpegurl
</IfModule>

# 6. Caché en navegador para estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 7. Proteger directorios y archivos sensibles
<FilesMatch "^\.(?!well-known)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|package\.json|package-lock\.json|\.env|\.db|\.sqlite|\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger base de datos local y directorio tools
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tools/ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^data/movieplus/catalog\.db - [F,L]

    # Protocolo Stremio Addon en PHP (100% compatible con InfinityFree, 0% Node.js, 0% límite de Render)
    RewriteRule ^manifest\.json$ api/stremio.php?action=manifest [QSA,L]
    RewriteRule ^stremio/manifest\.json$ api/stremio.php?action=manifest [QSA,L]
    RewriteRule ^stremio/([^/]+)/manifest\.json$ api/stremio.php?action=manifest&config=$1 [QSA,L]
    RewriteRule ^stremio/(?:([^/]+)/)?catalog/([^/]+)/([^/]+)\.json$ api/stremio.php?action=catalog&config=$1&type=$2&id=$3 [QSA,L]
    RewriteRule ^catalog/([^/]+)/([^/]+)\.json$ api/stremio.php?action=catalog&type=$1&id=$2 [QSA,L]
    RewriteRule ^stremio/(?:([^/]+)/)?stream/([^/]+)/([^/]+)\.json$ api/stremio.php?action=stream&config=$1&type=$2&id=$3 [QSA,L]
    RewriteRule ^stream/([^/]+)/([^/]+)\.json$ api/stremio.php?action=stream&type=$1&id=$2 [QSA,L]
</IfModule>
