# ==============================================================================
# Git Ignore - Web Media Multistream
# ==============================================================================

# Archivos temporales y del sistema operativo
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp

# Archivos comprimidos y respaldos locales pesados
*.zip
*.rar
*.tar.gz
*.7z
appp.zip

# Logs y registros de error
*.log
error_log

# Configuración local de IDEs / Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Variables de entorno o configuraciones sensibles
.env
.env.local
.env.*.local

# Scripts temporales de pruebas y experimentos
scratch/

# Caché dinámica generada por el servidor (se conserva la carpeta con .gitkeep)
data/cache/*
!data/cache/.gitkeep

# Historial local de visualización del usuario y dispositivos
data/watched_progress.json
data/progress/*
!data/progress/.gitkeep
data/watchlist/*
!data/watchlist/.gitkeep

# Caché de streaming de torrents
data/torrent_cache/*
!data/torrent_cache/.gitkeep
temp_cache/

# Dependencias Node.js
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json

